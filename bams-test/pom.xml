<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.shopee.banking</groupId>
        <artifactId>bams</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>bams-test</artifactId>
    <packaging>jar</packaging>
    <name>BAMS Test</name>

    <dependencies>
        <dependency>
            <groupId>com.shopee.banking</groupId>
            <artifactId>bams-adapter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.shopee.banking</groupId>
            <artifactId>bams-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.shopee.banking</groupId>
            <artifactId>bams-app</artifactId>
        </dependency>
        <dependency>
            <groupId>com.shopee.banking</groupId>
            <artifactId>bams-domain</artifactId>
        </dependency>
        <dependency>
            <groupId>com.shopee.banking</groupId>
            <artifactId>bams-infra</artifactId>
        </dependency>
        <dependency>
            <groupId>com.shopee.banking</groupId>
            <artifactId>bams-common</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report-aggregate</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report-aggregate</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
