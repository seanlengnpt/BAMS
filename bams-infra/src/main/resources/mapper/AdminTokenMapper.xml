<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.shopee.banking.bams.infra.dal.mapper.AdminTokenMapper">

    <resultMap id="BaseResultMap" type="com.shopee.banking.bams.infra.dal.dataObject.AdminTokenDO">
        <id property="id" column="id"/>
        <result property="adminId" column="admin_id"/>
        <result property="refreshToken" column="refresh_token"/>
        <result property="revoked" column="revoked"/>
        <result property="createdAt" column="created_at"/>
        <result property="expiresAt" column="expires_at"/>
    </resultMap>

    <insert id="insert" parameterType="com.shopee.banking.bams.infra.dal.dataObject.AdminTokenDO"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO admin_tokens (admin_id, refresh_token, revoked, created_at, expires_at)
        VALUES (#{adminId}, #{refreshToken}, #{revoked}, #{createdAt}, #{expiresAt})
    </insert>

    <select id="selectByRefreshToken" resultMap="BaseResultMap">
        SELECT id, admin_id, refresh_token, revoked, created_at, expires_at
        FROM admin_tokens
        WHERE refresh_token = #{refreshToken}
        LIMIT 1
    </select>

</mapper>
