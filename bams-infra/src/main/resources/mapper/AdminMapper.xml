<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.shopee.banking.bams.infra.dal.mapper.AdminMapper">

    <resultMap id="BaseResultMap" type="com.shopee.banking.bams.infra.dal.dataObject.AdminDO">
        <id property="id" column="id"/>
        <result property="username" column="username"/>
        <result property="password" column="password"/>
        <result property="nickname" column="nickname"/>
        <result property="profilePictureUrl" column="profile_pic"/>
    </resultMap>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT id, username, password, nickname, profile_pic
        FROM admin
        WHERE id = #{id}
    </select>

    <select id="selectByUsername" resultMap="BaseResultMap">
        SELECT id, username, password, nickname, profile_pic
        FROM admin
        WHERE username = #{username}
        LIMIT 1
    </select>

    <update id="updateProfile">
        UPDATE admin
        <set>
            <if test="nickname != null">
                nickname = #{nickname},
            </if>
            <if test="profilePictureUrl != null">
                profile_pic = #{profilePictureUrl},
            </if>
            modified_at = NOW()
        </set>
        WHERE id = #{id}
    </update>

</mapper>
